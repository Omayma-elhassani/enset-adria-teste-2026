enum AccountStatus { ACTIVE BLOCKED }

type Account {
    id: ID!
    customerReference: String!
    status: AccountStatus!
    currency: String!
    balance: Float!
}

input AccountRequest {
    customerReference: String!
    currency: String!
    initialBalance: Float!
}

type Query {
    accounts: [Account]
    accountById(id: ID!): Account
    accountsByCustomer(customerReference: String!): [Account]
}

type Mutation {
    createAccount(input: AccountRequest!): Account
    changeAccountStatus(id: ID!, status: AccountStatus!): Account
}
